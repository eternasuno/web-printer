{
  "name": "web-printer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && vite preview",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "dompurify": "3.4.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/tampermonkey": "5.5.0",
    "jsdom": "^30.0.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-monkey": "8.1.0",
    "vitest": "4.1.11"
  }
}
